export SQL_DATABASE=aigle
export SQL_USER=aigle
export SQL_PASSWORD=
export SQL_HOST=0.0.0.0
export SQL_PORT=5492
# shp_to_postgis.sh does not export it, psql reads it from the environment
export PGPASSWORD=$SQL_PASSWORD

# copy_detections_schema.sh: copies the `detections` schema FROM source TO target.
# SOURCE = the db read from (preprod). TARGET = the db overwritten (prod).
export SOURCE_DB_HOST=
export SOURCE_DB_PORT=5432
export SOURCE_DB_USER=
export SOURCE_DB_PASSWORD=
export SOURCE_DB_NAME=
# export SOURCE_DB_SSLMODE=require   # set for managed/remote DBs

export TARGET_DB_HOST=
export TARGET_DB_PORT=5432
export TARGET_DB_USER=
export TARGET_DB_PASSWORD=
export TARGET_DB_NAME=
# export TARGET_DB_SSLMODE=require

# export BACKUP_DIR=/Volumes/data/aigle   # where copy_detections_schema.sh writes its dump
